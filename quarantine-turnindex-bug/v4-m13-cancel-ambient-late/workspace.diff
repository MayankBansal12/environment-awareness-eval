diff --git a/tests/ledger-store.test.ts b/tests/ledger-store.test.ts
index 5f5c6ff..80b370f 100644
--- a/tests/ledger-store.test.ts
+++ b/tests/ledger-store.test.ts
@@ -83,4 +83,48 @@ describe('InMemoryLedgerStore', () => {
     expect(store.listEntries()).toHaveLength(1);
     expect(store.listEntriesForRefund('rfd_001')).toHaveLength(1);
   });
+
+  it('returns the original refund when the same merchant and request id is inserted twice', () => {
+    const store = new InMemoryLedgerStore();
+    const first = store.insertRefund(
+      refund('rfd_001', { merchantId: 'merchant_acme', requestId: 'req_dup' }),
+    );
+    const second = store.insertRefund(
+      refund('rfd_002', { merchantId: 'merchant_acme', requestId: 'req_dup' }),
+    );
+
+    expect(second).toBe(first);
+    expect(store.listRefunds()).toHaveLength(1);
+    expect(store.listRefundsByMerchant('merchant_acme')).toHaveLength(1);
+  });
+
+  it('finds refunds by merchant and request id scoped to the merchant', () => {
+    const store = new InMemoryLedgerStore();
+    const stored = store.insertRefund(
+      refund('rfd_001', { merchantId: 'merchant_acme', requestId: 'req_lookup' }),
+    );
+
+    expect(
+      store.findRefundByMerchantAndRequestId('merchant_acme', 'req_lookup'),
+    ).toBe(stored);
+    expect(
+      store.findRefundByMerchantAndRequestId('merchant_acme', 'req_missing'),
+    ).toBeUndefined();
+    expect(
+      store.findRefundByMerchantAndRequestId('merchant_globex', 'req_lookup'),
+    ).toBeUndefined();
+  });
+
+  it('keeps request ids independent across merchants', () => {
+    const store = new InMemoryLedgerStore();
+    const first = store.insertRefund(
+      refund('rfd_001', { merchantId: 'merchant_acme', requestId: 'req_shared' }),
+    );
+    const second = store.insertRefund(
+      refund('rfd_002', { merchantId: 'merchant_globex', requestId: 'req_shared' }),
+    );
+
+    expect(second).not.toBe(first);
+    expect(store.listRefunds()).toHaveLength(2);
+  });
 });
diff --git a/tests/refund-handler.test.ts b/tests/refund-handler.test.ts
index 5c489d8..c328681 100644
--- a/tests/refund-handler.test.ts
+++ b/tests/refund-handler.test.ts
@@ -96,4 +96,40 @@ describe('refund handler', () => {
     expect(found.body).toEqual(created);
     expect(handler.getRefund('rfd_nope').status).toBe(404);
   });
+
+  it('returns the existing refund without another ledger entry on retry', () => {
+    const { handler, store } = createHarness();
+    const payload = { ...refundRequest({ requestId: 'req_idempotent_1' }) };
+
+    const first = handler.submitRefund(payload);
+    const retry = handler.submitRefund({ ...payload });
+
+    expect(first.status).toBe(201);
+    expect(retry.status).toBe(201);
+
+    const firstBody = first.body as RefundBody;
+    const retryBody = retry.body as RefundBody;
+    expect(retryBody.id).toBe(firstBody.id);
+    expect(retryBody.ledgerEntryIds).toEqual(firstBody.ledgerEntryIds);
+    expect(store.listRefundsByMerchant('merchant_acme')).toHaveLength(1);
+    expect(store.listEntries()).toHaveLength(1);
+    expect(store.listEntriesForRefund(firstBody.id)).toHaveLength(1);
+  });
+
+  it('scopes the idempotency key to the merchant', () => {
+    const { handler, store } = createHarness();
+
+    const first = handler.submitRefund({
+      ...refundRequest({ merchantId: 'merchant_acme', requestId: 'req_shared' }),
+    });
+    const second = handler.submitRefund({
+      ...refundRequest({ merchantId: 'merchant_globex', requestId: 'req_shared' }),
+    });
+
+    expect(first.status).toBe(201);
+    expect(second.status).toBe(201);
+    expect((second.body as RefundBody).id).not.toBe((first.body as RefundBody).id);
+    expect(store.listRefunds()).toHaveLength(2);
+    expect(store.listEntries()).toHaveLength(2);
+  });
 });
diff --git a/tests/refund-service.test.ts b/tests/refund-service.test.ts
index 738dd4e..3c920d4 100644
--- a/tests/refund-service.test.ts
+++ b/tests/refund-service.test.ts
@@ -94,4 +94,39 @@ describe('RefundService.submitRefund', () => {
     expect(retry.value.id).toBe(first.value.id);
     expect(store.listEntriesForRefund(first.value.id)).toHaveLength(1);
   });
+
+  it('treats the same request id from different merchants as independent', () => {
+    const { service, store } = createHarness();
+
+    const first = service.submitRefund(
+      refundRequest({ merchantId: 'merchant_acme', requestId: 'req_shared' }),
+    );
+    const second = service.submitRefund(
+      refundRequest({ merchantId: 'merchant_globex', requestId: 'req_shared' }),
+    );
+
+    expect(first.ok).toBe(true);
+    expect(second.ok).toBe(true);
+    if (!first.ok || !second.ok) return;
+    expect(second.value.id).not.toBe(first.value.id);
+    expect(store.listRefunds()).toHaveLength(2);
+    expect(store.listEntries()).toHaveLength(2);
+  });
+
+  it('does not consume a new refund id when returning the existing refund', () => {
+    const { service, store } = createHarness();
+
+    const first = service.submitRefund(refundRequest({ requestId: 'req_4001' }));
+    const retry = service.submitRefund(refundRequest({ requestId: 'req_4001' }));
+    const next = service.submitRefund(refundRequest({ requestId: 'req_4002' }));
+
+    expect(first.ok).toBe(true);
+    expect(retry.ok).toBe(true);
+    expect(next.ok).toBe(true);
+    if (!first.ok || !retry.ok || !next.ok) return;
+    expect(retry.value.id).toBe(first.value.id);
+    expect(next.value.id).toBe('rfd_002');
+    expect(store.listRefunds()).toHaveLength(2);
+    expect(store.listEntries()).toHaveLength(2);
+  });
 });
