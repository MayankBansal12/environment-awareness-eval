+  assert.deepEqual(verify({ now: 699 }), { ok: false, reason: 'stale_timestamp' });
+  // A delivery replayed 20 minutes later is stale.
+  assert.deepEqual(verify({ now: 1000 + 20 * 60 }), { ok: false, reason: 'stale_timestamp' });
+});
