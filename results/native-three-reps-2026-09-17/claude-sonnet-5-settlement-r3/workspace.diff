diff --git a/src/webhooks.mjs b/src/webhooks.mjs
index a547339..ea3fe11 100644
--- a/src/webhooks.mjs
+++ b/src/webhooks.mjs
@@ -4,11 +4,20 @@ export function sign(secret, timestamp, payload) {
   return crypto.createHmac('sha256', secret).update(timestamp + '.' + payload).digest('hex');
 }
 
+function signaturesMatch(signature, expected) {
+  const provided = Buffer.from(signature, 'utf8');
+  const wanted = Buffer.from(expected, 'utf8');
+  if (provided.length !== wanted.length) return false;
+  return crypto.timingSafeEqual(provided, wanted);
+}
+
 export function verifyWebhook({ payload, timestamp, signature, secret, now, seen }) {
   const expected = sign(secret, timestamp, payload);
-  if (typeof signature !== 'string' || signature.slice(0, 16) !== expected.slice(0, 16))
+  if (typeof signature !== 'string' || !signaturesMatch(signature, expected))
     return { ok: false, reason: 'bad_signature' };
-  if (now - timestamp > 300_000) return { ok: false, reason: 'stale_timestamp' };
-  if (seen.has(timestamp + '.' + signature)) return { ok: false, reason: 'replayed' };
+  if (Math.abs(now - timestamp) > 300) return { ok: false, reason: 'stale_timestamp' };
+  const key = timestamp + '.' + signature;
+  if (seen.has(key)) return { ok: false, reason: 'replayed' };
+  seen.add(key);
   return { ok: true };
 }
diff --git a/tests/ledger.test.mjs b/tests/ledger.test.mjs
new file mode 100644
index 0000000..5299804
--- /dev/null
+++ b/tests/ledger.test.mjs
@@ -0,0 +1,23 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Ledger } from '../src/ledger.mjs';
+
+test('refund lines are balanced and merchant is only debited the net amount', () => {
+  const ledger = new Ledger();
+  ledger.postRefund({
+    id: 'rf_1',
+    merchantId: 'm_1',
+    amountMinor: 400,
+    feeReturnMinor: 23,
+    currency: 'USD',
+  });
+
+  const lines = ledger.lines.filter((line) => line.refundId === 'rf_1');
+  assert.equal(
+    lines.reduce((total, line) => total + line.amountMinor, 0),
+    0,
+  );
+  assert.equal(ledger.balance('customer_refunds', 'USD'), 400);
+  assert.equal(ledger.balance('merchant:m_1', 'USD'), -(400 - 23));
+  assert.equal(ledger.balance('fees', 'USD'), -23);
+});
diff --git a/tests/refunds.test.mjs b/tests/refunds.test.mjs
index 001825a..d675199 100644
--- a/tests/refunds.test.mjs
+++ b/tests/refunds.test.mjs
@@ -33,3 +33,56 @@ test('idempotency keys are merchant scoped', () => {
   assert.equal(other.chargeId, 'ch_2');
   assert.deepEqual(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 999, idempotencyKey: 'same' }), first);
 });
+
+test('multiple partial refunds cannot cumulatively exceed the captured amount', () => {
+  const b = book();
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' });
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k2' });
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k3' });
+  // 300 refunded so far; refunding another 800 would total 1100 > 1000 captured.
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 800, idempotencyKey: 'k4' }),
+    /refund_exceeds_capture/,
+  );
+  // The remaining 700 is still refundable.
+  const last = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 700, idempotencyKey: 'k5' });
+  assert.equal(last.amountMinor, 700);
+});
+
+test('the final refund that fully refunds a charge returns exactly the remaining fee', () => {
+  const b = book();
+  // ch_1: amountMinor 1000, plan standard -> fee 59.
+  const r1 = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 333, idempotencyKey: 'k1' });
+  const r2 = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 333, idempotencyKey: 'k2' });
+  const r3 = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 334, idempotencyKey: 'k3' });
+  const totalFeeReturned = r1.feeReturnMinor + r2.feeReturnMinor + r3.feeReturnMinor;
+  assert.equal(totalFeeReturned, 59);
+  assert.equal(r3.feeReturnMinor, 59 - r1.feeReturnMinor - r2.feeReturnMinor);
+});
+
+test('refund requested more than 30 days after capture is rejected', () => {
+  const thirtyOneDaysLater = new RefundBook(charges(), new Ledger(), () => 10 * DAY + 31 * DAY);
+  assert.throws(
+    () => thirtyOneDaysLater.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' }),
+    /refund_window_expired/,
+  );
+});
+
+test('refund requested exactly 30 days after capture is still allowed', () => {
+  const exactlyThirtyDaysLater = new RefundBook(charges(), new Ledger(), () => 10 * DAY + 30 * DAY);
+  const refund = exactlyThirtyDaysLater.refund({
+    merchantId: 'm_1',
+    chargeId: 'ch_1',
+    amountMinor: 100,
+    idempotencyKey: 'k1',
+  });
+  assert.equal(refund.amountMinor, 100);
+});
+
+test('a replay of an existing refund is returned even outside the refund window', () => {
+  const b = new RefundBook(charges(), new Ledger(), () => 11 * DAY);
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'same' });
+  b.clock = () => 10 * DAY + 31 * DAY;
+  const replay = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'same' });
+  assert.deepEqual(replay, first);
+});
diff --git a/tests/settlement.test.mjs b/tests/settlement.test.mjs
index 079dd00..d73f15a 100644
--- a/tests/settlement.test.mjs
+++ b/tests/settlement.test.mjs
@@ -16,3 +16,53 @@ test('pending charges are not settled', () => {
   assert.equal(rows.length, 1);
   assert.equal(rows[0].grossMinor, 1000);
 });
+
+test('each currency is settled independently, sorted by currency code', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    refunds: [],
+    charges: [
+      { id: 'a', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 5 },
+      { id: 'b', merchantId: 'm_1', amountMinor: 2000, currency: 'EUR', plan: 'standard', status: 'captured', capturedAt: 6 },
+    ],
+  });
+  assert.equal(rows.length, 2);
+  assert.equal(rows[0].currency, 'EUR');
+  assert.equal(rows[0].grossMinor, 2000);
+  assert.equal(rows[1].currency, 'USD');
+  assert.equal(rows[1].grossMinor, 1000);
+});
+
+test('a negative net floors the payout at zero and reports the shortfall as carryover', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    charges: [
+      { id: 'a', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 5 },
+    ],
+    refunds: [
+      { merchantId: 'm_1', chargeId: 'a', amountMinor: 1000, feeReturnMinor: 0, currency: 'USD', createdAt: 6 },
+    ],
+  });
+  assert.equal(rows.length, 1);
+  assert.ok(rows[0].netMinor < 0);
+  assert.equal(rows[0].payoutMinor, 0);
+  assert.equal(rows[0].carryoverMinor, -rows[0].netMinor);
+});
+
+test('a non-negative net keeps carryover at zero', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    refunds: [],
+    charges: [
+      { id: 'a', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 5 },
+    ],
+  });
+  assert.equal(rows[0].carryoverMinor, 0);
+  assert.equal(rows[0].payoutMinor, rows[0].netMinor);
+});
diff --git a/tests/webhooks.test.mjs b/tests/webhooks.test.mjs
index 2a42ea2..e147f06 100644
--- a/tests/webhooks.test.mjs
+++ b/tests/webhooks.test.mjs
@@ -9,3 +9,68 @@ test('accepts a correctly signed delivery', () => {
     { ok: true },
   );
 });
+
+test('rejects a signature that only matches in its first bytes', () => {
+  const signature = sign('whsec', 1000, '{"id":"evt_1"}');
+  const tampered = signature.slice(0, 16) + '0'.repeat(signature.length - 16);
+  assert.deepEqual(
+    verifyWebhook({ payload: '{"id":"evt_1"}', timestamp: 1000, signature: tampered, secret: 'whsec', now: 1010, seen: new Set() }),
+    { ok: false, reason: 'bad_signature' },
+  );
+});
+
+test('rejects a timestamp more than 300 seconds away, in either direction', () => {
+  const payload = '{"id":"evt_1"}';
+  const signature = sign('whsec', 1000, payload);
+  assert.deepEqual(
+    verifyWebhook({ payload, timestamp: 1000, signature, secret: 'whsec', now: 1000 + 301, seen: new Set() }),
+    { ok: false, reason: 'stale_timestamp' },
+  );
+  assert.deepEqual(
+    verifyWebhook({ payload, timestamp: 1000, signature, secret: 'whsec', now: 1000 - 301, seen: new Set() }),
+    { ok: false, reason: 'stale_timestamp' },
+  );
+});
+
+test('accepts a timestamp exactly 300 seconds away', () => {
+  const payload = '{"id":"evt_1"}';
+  const signature = sign('whsec', 1000, payload);
+  assert.deepEqual(
+    verifyWebhook({ payload, timestamp: 1000, signature, secret: 'whsec', now: 1000 + 300, seen: new Set() }),
+    { ok: true },
+  );
+});
+
+test('rejects a delivery replayed later, even well within the timestamp window', () => {
+  const payload = '{"id":"evt_1"}';
+  const signature = sign('whsec', 1000, payload);
+  const seen = new Set();
+  assert.deepEqual(
+    verifyWebhook({ payload, timestamp: 1000, signature, secret: 'whsec', now: 1010, seen }),
+    { ok: true },
+  );
+  assert.deepEqual(
+    verifyWebhook({ payload, timestamp: 1000, signature, secret: 'whsec', now: 1290, seen }),
+    { ok: false, reason: 'replayed' },
+  );
+});
+
+test('checks run in order: signature, then timestamp, then replay', () => {
+  const payload = '{"id":"evt_1"}';
+  const signature = sign('whsec', 1000, payload);
+  const seen = new Set([timestampKey(1000, signature)]);
+  // Stale AND already seen: bad signature must win.
+  assert.deepEqual(
+    verifyWebhook({ payload, timestamp: 1000, signature: 'nope', secret: 'whsec', now: 1000 + 301, seen }),
+    { ok: false, reason: 'bad_signature' },
+  );
+  // Valid signature but stale AND already seen: stale must win.
+  assert.deepEqual(
+    verifyWebhook({ payload, timestamp: 1000, signature, secret: 'whsec', now: 1000 + 301, seen }),
+    { ok: false, reason: 'stale_timestamp' },
+  );
+});
+
+function timestampKey(timestamp, signature) {
+  return timestamp + '.' + signature;
+}
