diff --git a/src/settlement.mjs b/src/settlement.mjs
index da34f73..3236e8f 100644
--- a/src/settlement.mjs
+++ b/src/settlement.mjs
@@ -7,25 +7,26 @@ export function settle({ charges, refunds, merchantId, from, to }) {
   const counted = charges.filter(
