diff --git a/tests/allocation.test.mjs b/tests/allocation.test.mjs
new file mode 100644
index 0000000..29dcd76
--- /dev/null
+++ b/tests/allocation.test.mjs
@@ -0,0 +1,45 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { allocate } from '../src/allocation.mjs';
+
+test('allocate only takes the available quantity, not raw onHand', () => {
+  const levels = [
+    { warehouse: 'w1', sku: 'cap', onHand: 5, held: 3, priority: 1 },
+    { warehouse: 'w2', sku: 'cap', onHand: 5, held: 0, priority: 2 },
+  ];
+  const result = allocate(levels, 4);
+  assert.deepEqual(result, {
+    lines: [
+      { warehouse: 'w1', quantity: 2 },
+      { warehouse: 'w2', quantity: 2 },
+    ],
+    backorderQuantity: 0,
+  });
+});
+
+test('allocate breaks priority ties by warehouse id ascending', () => {
+  const levels = [
+    { warehouse: 'w2', sku: 'cap', onHand: 5, held: 0, priority: 1 },
+    { warehouse: 'w1', sku: 'cap', onHand: 5, held: 0, priority: 1 },
+  ];
+  const result = allocate(levels, 3);
+  assert.deepEqual(result.lines, [{ warehouse: 'w1', quantity: 3 }]);
+});
+
+test('levels with nothing available produce no line', () => {
+  const levels = [
+    { warehouse: 'w1', sku: 'cap', onHand: 2, held: 2, priority: 1 },
+    { warehouse: 'w2', sku: 'cap', onHand: 5, held: 0, priority: 2 },
+  ];
+  const result = allocate(levels, 3);
+  assert.deepEqual(result.lines, [{ warehouse: 'w2', quantity: 3 }]);
+});
+
+test('remaining quantity beyond all available stock is reported as backorder', () => {
+  const levels = [
+    { warehouse: 'w1', sku: 'cap', onHand: 2, held: 0, priority: 1 },
+    { warehouse: 'w2', sku: 'cap', onHand: 1, held: 1, priority: 2 },
+  ];
+  const result = allocate(levels, 5);
+  assert.deepEqual(result, { lines: [{ warehouse: 'w1', quantity: 2 }], backorderQuantity: 3 });
+});
diff --git a/tests/api.test.mjs b/tests/api.test.mjs
new file mode 100644
index 0000000..d866e80
--- /dev/null
+++ b/tests/api.test.mjs
@@ -0,0 +1,35 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Stock } from '../src/stock.mjs';
+import { ReservationBook } from '../src/reservations.mjs';
+import { handleReserve } from '../src/api.mjs';
+
+const setup = () => {
+  const stock = new Stock([{ warehouse: 'w1', sku: 'cap', onHand: 2, priority: 1 }]);
+  return new ReservationBook(stock, () => 0);
+};
+
+test('handleReserve returns 201 with the reservation on success', () => {
+  const book = setup();
+  const result = handleReserve(book, { orderId: 'o1', sku: 'cap', quantity: 2 });
+  assert.equal(result.status, 201);
+  assert.equal(result.body.status, 'held');
+});
+
+test('handleReserve maps insufficient_stock to 409', () => {
+  const book = setup();
+  const result = handleReserve(book, { orderId: 'o1', sku: 'cap', quantity: 3 });
+  assert.deepEqual(result, { status: 409, body: { error: 'insufficient_stock' } });
+});
+
+test('handleReserve maps invalid_request and invalid_quantity to 400', () => {
+  const book = setup();
+  assert.equal(handleReserve(book, { orderId: '', sku: 'cap', quantity: 1 }).status, 400);
+  assert.equal(handleReserve(book, { orderId: 'o1', sku: 'cap', quantity: -1 }).status, 400);
+});
+
+test('handleReserve maps unexpected errors to 500', () => {
+  const book = { reserve: () => { throw new Error('boom'); } };
+  const result = handleReserve(book, {});
+  assert.deepEqual(result, { status: 500, body: { error: 'internal' } });
+});
diff --git a/tests/audit.test.mjs b/tests/audit.test.mjs
new file mode 100644
index 0000000..96e9407
--- /dev/null
+++ b/tests/audit.test.mjs
@@ -0,0 +1,20 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { AuditLog } from '../src/audit.mjs';
+
+test('mutating the object passed to record does not change the stored entry', () => {
+  const log = new AuditLog();
+  const entry = { type: 'reserved', reservationId: 'res_1', at: 1 };
+  log.record(entry);
+  entry.type = 'tampered';
+  assert.equal(log.entries()[0].type, 'reserved');
+});
+
+test('mutating a returned entry or the returned array does not change the log', () => {
+  const log = new AuditLog();
+  log.record({ type: 'reserved', reservationId: 'res_1', at: 1 });
+  const entries = log.entries();
+  entries[0].type = 'tampered';
+  entries.push({ type: 'fake', reservationId: 'res_2', at: 2 });
+  assert.deepEqual(log.entries(), [{ type: 'reserved', reservationId: 'res_1', at: 1 }]);
+});
diff --git a/tests/pricing.test.mjs b/tests/pricing.test.mjs
index 0f6be2e..c4dead3 100644
--- a/tests/pricing.test.mjs
+++ b/tests/pricing.test.mjs
@@ -9,3 +9,60 @@ test('prices an order without coupons', () => {
     totalMinor: 1000,
   });
 });
+
+test('percent coupons always apply before fixed coupons, regardless of array order', () => {
+  const lines = [{ unitMinor: 1000, quantity: 1 }];
+  const percentFirst = priceOrder({
+    lines,
+    coupons: [
+      { type: 'percent', value: 10 },
+      { type: 'fixed', value: 200 },
+    ],
+  });
+  const fixedFirst = priceOrder({
+    lines,
+    coupons: [
+      { type: 'fixed', value: 200 },
+      { type: 'percent', value: 10 },
+    ],
+  });
+  const expected = { subtotalMinor: 1000, discountMinor: 300, totalMinor: 700 };
+  assert.deepEqual(percentFirst, expected);
+  assert.deepEqual(fixedFirst, expected);
+});
+
+test('percent discount uses round-half-even', () => {
+  // subtotal 25, 1% of 25 = 0.25 minor units -> roundHalfEven(25, 100) rounds down to 0.
+  const result = priceOrder({
+    lines: [{ unitMinor: 5, quantity: 5 }],
+    coupons: [{ type: 'percent', value: 1 }],
+  });
+  assert.equal(result.discountMinor, 0);
+  assert.equal(result.totalMinor, 25);
+});
+
+test('total never goes below zero even when fixed coupons exceed the total', () => {
+  const result = priceOrder({
+    lines: [{ unitMinor: 100, quantity: 1 }],
+    coupons: [{ type: 'fixed', value: 500 }],
+  });
+  assert.deepEqual(result, { subtotalMinor: 100, discountMinor: 100, totalMinor: 0 });
+});
+
+test('rejects malformed coupons', () => {
+  const lines = [{ unitMinor: 100, quantity: 1 }];
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'percent', value: 0 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'percent', value: 101 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'percent', value: 1.5 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'fixed', value: 0 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'fixed', value: -5 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'bogus', value: 5 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [null] }), /invalid_coupon/);
+});
+
+test('rejects malformed order lines', () => {
+  assert.throws(() => priceOrder({ lines: [] }), /invalid_order/);
+  assert.throws(() => priceOrder({ lines: [{ unitMinor: -1, quantity: 1 }] }), /invalid_order/);
+  assert.throws(() => priceOrder({ lines: [{ unitMinor: 1, quantity: 0 }] }), /invalid_order/);
+  assert.throws(() => priceOrder({ lines: [{ unitMinor: 1.5, quantity: 1 }] }), /invalid_order/);
+});
diff --git a/tests/reservations.test.mjs b/tests/reservations.test.mjs
index d63ace7..f9ad33b 100644
--- a/tests/reservations.test.mjs
+++ b/tests/reservations.test.mjs
@@ -44,3 +44,51 @@ test('quantities must be positive integers', () => {
   for (const quantity of [0, -1, 1.5])
     assert.throws(() => book.reserve({ orderId: 'o1', sku: 'cap', quantity }), /invalid_quantity/);
 });
+
+test('vip holds last 30 minutes while other tiers keep 10 minutes', () => {
+  const { clock, book } = setup();
+  const vip = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 1, customerTier: 'vip' });
+  assert.equal(vip.expiresAt, 30 * MIN);
+  const standard = book.reserve({ orderId: 'o2', sku: 'cap', quantity: 1 });
+  assert.equal(standard.expiresAt, 10 * MIN);
+  const unknownTier = book.reserve({ orderId: 'o3', sku: 'cap', quantity: 1, customerTier: 'unknown' });
+  assert.equal(unknownTier.expiresAt, 10 * MIN);
+
+  clock.set(10 * MIN);
+  assert.equal(book.available('cap'), 9);
+  clock.set(30 * MIN);
+  assert.equal(book.available('cap'), 10);
+});
+
+test('reserve is all-or-nothing: insufficient stock holds nothing', () => {
+  const { book } = setup();
+  assert.throws(
+    () => book.reserve({ orderId: 'o1', sku: 'cap', quantity: 11 }),
+    /insufficient_stock/,
+  );
+  assert.equal(book.available('cap'), 10);
+});
+
+test('successful reservations always report backorderQuantity 0', () => {
+  const { book } = setup();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 10 });
+  assert.equal(hold.backorderQuantity, 0);
+});
+
+test('commit expires a due hold first and throws reservation_expired', () => {
+  const { clock, book } = setup();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 2 });
+  clock.set(10 * MIN);
+  assert.throws(() => book.commit(hold.id), /reservation_expired/);
+  assert.equal(book.available('cap'), 10);
+});
+
+test('releasing a committed reservation does not free its stock twice', () => {
+  const { book } = setup();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 4 });
+  book.commit(hold.id);
+  assert.equal(book.available('cap'), 6);
+  const released = book.release(hold.id);
+  assert.equal(released.status, 'committed');
+  assert.equal(book.available('cap'), 6);
+});
