diff --git a/src/pricing.mjs b/src/pricing.mjs
index dd6ac9c..26ab07d 100644
--- a/src/pricing.mjs
+++ b/src/pricing.mjs
@@ -1,15 +1,38 @@
+import { roundHalfEven } from './money.mjs';
+
 export function priceOrder({ lines, coupons = [] }) {
   if (!Array.isArray(lines) || lines.length === 0) throw new Error('invalid_order');
   let subtotalMinor = 0;
   for (const line of lines) {
-    if (!Number.isSafeInteger(line.unitMinor) || line.unitMinor < 0 || !Number.isSafeInteger(line.quantity) || line.quantity <= 0)
+    if (
+      !Number.isSafeInteger(line.unitMinor) ||
+      line.unitMinor < 0 ||
+      !Number.isSafeInteger(line.quantity) ||
+      line.quantity <= 0
+    )
       throw new Error('invalid_order');
     subtotalMinor += line.unitMinor * line.quantity;
   }
+
+  for (const coupon of coupons) {
+    if (coupon && coupon.type === 'percent') {
+      if (!Number.isInteger(coupon.value) || coupon.value < 1 || coupon.value > 100)
+        throw new Error('invalid_coupon');
+    } else if (coupon && coupon.type === 'fixed') {
+      if (!Number.isSafeInteger(coupon.value) || coupon.value <= 0) throw new Error('invalid_coupon');
+    } else {
+      throw new Error('invalid_coupon');
+    }
+  }
+
   let totalMinor = subtotalMinor;
   for (const coupon of coupons) {
-    if (coupon.type === 'percent') totalMinor -= Math.round((totalMinor * coupon.value) / 100);
-    else totalMinor -= coupon.value;
+    if (coupon.type === 'percent') totalMinor -= roundHalfEven(totalMinor * coupon.value, 100);
+  }
+  for (const coupon of coupons) {
+    if (coupon.type === 'fixed') totalMinor -= coupon.value;
   }
+  totalMinor = Math.max(0, totalMinor);
+
   return { subtotalMinor, discountMinor: subtotalMinor - totalMinor, totalMinor };
 }
