@@ -16,3 +16,84 @@ test('pending charges are not settled', () => {
   assert.equal(rows.length, 1);
   assert.equal(rows[0].grossMinor, 1000);
 });
+
+test('only captured charges are settled, not pending or failed', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    refunds: [],
+    charges: [
+      { id: 'a', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 5 },
+      { id: 'b', merchantId: 'm_1', amountMinor: 700, currency: 'USD', plan: 'standard', status: 'pending', capturedAt: 6 },
+      { id: 'c', merchantId: 'm_1', amountMinor: 900, currency: 'USD', plan: 'standard', status: 'failed', capturedAt: 7 },
+    ],
+  });
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].grossMinor, 1000);
+});
+
+test('returns one row per currency, sorted by currency code', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    refunds: [],
+    charges: [
+      { id: 'a', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 5 },
+      { id: 'b', merchantId: 'm_1', amountMinor: 2000, currency: 'EUR', plan: 'standard', status: 'captured', capturedAt: 6 },
+    ],
+  });
+  assert.deepEqual(rows.map((row) => row.currency), ['EUR', 'USD']);
+  assert.equal(rows.find((row) => row.currency === 'USD').grossMinor, 1000);
+  assert.equal(rows.find((row) => row.currency === 'EUR').grossMinor, 2000);
+});
+
+test('a currency with only refunds in the window still gets its own row', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    charges: [],
+    refunds: [
+      { id: 'rf_1', merchantId: 'm_1', chargeId: 'ch_x', amountMinor: 100, feeReturnMinor: 5, currency: 'GBP', createdAt: 10 },
+    ],
+  });
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].currency, 'GBP');
+  assert.equal(rows[0].refundsMinor, 100);
+});
+
+test('a negative net floors the payout at 0 and reports the shortfall as carryover', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    charges: [
+      { id: 'a', merchantId: 'm_1', amountMinor: 100, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 5 },
+    ],
+    refunds: [
+      { id: 'rf_1', merchantId: 'm_1', chargeId: 'a', amountMinor: 100, feeReturnMinor: 3, currency: 'USD', createdAt: 10 },
+    ],
+  });
+  assert.equal(rows.length, 1);
+  const row = rows[0];
+  // gross 100, refunds 100, fees = feeFor(100,'standard') - 3 = 33 - 3 = 30 => net = 100 - 100 - 30 = -30
+  assert.equal(row.netMinor, -30);
+  assert.equal(row.payoutMinor, 0);
+  assert.equal(row.carryoverMinor, 30);
+});
+
+test('a non-negative net keeps carryover at 0', () => {
+  const rows = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    charges: [
+      { id: 'a', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 5 },
+    ],
+    refunds: [],
+  });
+  assert.equal(rows[0].carryoverMinor, 0);
+  assert.equal(rows[0].payoutMinor, rows[0].netMinor);
+});
