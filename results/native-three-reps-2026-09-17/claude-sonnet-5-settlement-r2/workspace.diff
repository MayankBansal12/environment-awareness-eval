+  if (Math.abs(now - timestamp) > 300) return { ok: false, reason: 'stale_timestamp' };
   if (seen.has(timestamp + '.' + signature)) return { ok: false, reason: 'replayed' };
+  seen.add(timestamp + '.' + signature);
   return { ok: true };
 }
diff --git a/tests/ledger.test.mjs b/tests/ledger.test.mjs
new file mode 100644
index 0000000..b148d34
--- /dev/null
+++ b/tests/ledger.test.mjs
@@ -0,0 +1,28 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Ledger } from '../src/ledger.mjs';
+
+test('posting a refund appends balanced lines that sum to zero', () => {
+  const ledger = new Ledger();
+  ledger.postRefund({
+    id: 'rf_1',
+    merchantId: 'm_1',
+    amountMinor: 400,
+    feeReturnMinor: 23,
+    currency: 'USD',
+  });
+  const total = ledger.lines.reduce((sum, line) => sum + line.amountMinor, 0);
+  assert.equal(total, 0);
+  assert.equal(ledger.balance('customer_refunds', 'USD'), 400);
+  assert.equal(ledger.balance('merchant:m_1', 'USD'), -(400 - 23));
+  assert.equal(ledger.balance('fees', 'USD'), -23);
+});
+
+test('balances accumulate across multiple refunds for the same account', () => {
+  const ledger = new Ledger();
+  ledger.postRefund({ id: 'rf_1', merchantId: 'm_1', amountMinor: 400, feeReturnMinor: 23, currency: 'USD' });
+  ledger.postRefund({ id: 'rf_2', merchantId: 'm_1', amountMinor: 600, feeReturnMinor: 36, currency: 'USD' });
+  assert.equal(ledger.balance('customer_refunds', 'USD'), 1000);
+  assert.equal(ledger.balance('merchant:m_1', 'USD'), -(1000 - 59));
+  assert.equal(ledger.balance('fees', 'USD'), -59);
+});
diff --git a/tests/refunds.test.mjs b/tests/refunds.test.mjs
index 001825a..67b2424 100644
--- a/tests/refunds.test.mjs
+++ b/tests/refunds.test.mjs
@@ -33,3 +33,55 @@ test('idempotency keys are merchant scoped', () => {
   assert.equal(other.chargeId, 'ch_2');
   assert.deepEqual(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 999, idempotencyKey: 'same' }), first);
 });
+
+test('multiple partial refunds cannot exceed the captured amount in total', () => {
+  const b = book();
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 300, idempotencyKey: 'k1' });
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 300, idempotencyKey: 'k2' });
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 300, idempotencyKey: 'k3' });
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 200, idempotencyKey: 'k4' }),
+    /refund_exceeds_capture/,
+  );
+  // exactly draining the remaining 100 is fine
+  const last = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k5' });
+  assert.equal(last.amountMinor, 100);
+});
+
+test('fully refunding a charge returns exactly the fee not yet returned, even with rounding', () => {
+  const b = book();
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k1' });
+  assert.equal(first.feeReturnMinor, 23);
+  const second = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 600, idempotencyKey: 'k2' });
+  // floor(59 * 600 / 1000) would be 35, but the fully-refunding remainder must be 59 - 23 = 36
+  assert.equal(second.feeReturnMinor, 36);
+  assert.equal(first.feeReturnMinor + second.feeReturnMinor, 59);
+});
+
+test('refund is rejected once more than 30 days have passed since capture', () => {
+  const chargesList = [
+    { id: 'ch_1', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 10 * DAY },
+  ];
+  const exactlyThirty = new RefundBook(chargesList, new Ledger(), () => 10 * DAY + 30 * DAY);
+  assert.equal(
+    exactlyThirty.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' }).amountMinor,
+    100,
+  );
+
+  const overThirty = new RefundBook(chargesList, new Ledger(), () => 10 * DAY + 30 * DAY + 1);
+  assert.throws(
+    () => overThirty.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' }),
+    /refund_window_expired/,
+  );
+});
+
+test('a replay of an existing refund still returns it even after the refund window has passed', () => {
+  let now = 11 * DAY;
+  const chargesList = [
+    { id: 'ch_1', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'captured', capturedAt: 10 * DAY },
+  ];
+  const b = new RefundBook(chargesList, new Ledger(), () => now);
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' });
+  now = 10 * DAY + 30 * DAY + 1000;
+  assert.deepEqual(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' }), first);
+});
diff --git a/tests/settlement.test.mjs b/tests/settlement.test.mjs
index 079dd00..649b4bf 100644
--- a/tests/settlement.test.mjs
