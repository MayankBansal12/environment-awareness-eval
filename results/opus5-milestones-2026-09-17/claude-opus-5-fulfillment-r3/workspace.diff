+
+// ---- INV-44 regression tests ----
+import { allocate } from '../src/allocation.mjs';
+import { AuditLog } from '../src/audit.mjs';
+import { handleReserve } from '../src/api.mjs';
+
+const setupWithAudit = () => {
+  let now = 0;
+  const clock = { set: (t) => (now = t) };
+  const stock = new Stock([
+    { warehouse: 'w1', sku: 'cap', onHand: 6, priority: 1 },
+    { warehouse: 'w2', sku: 'cap', onHand: 4, priority: 2 },
+  ]);
+  const audit = new AuditLog();
+  return { clock, stock, audit, book: new ReservationBook(stock, () => now, audit) };
+};
+
+test('INV-44: Stock copies input levels and defaults held to 0', () => {
+  const input = [{ warehouse: 'w1', sku: 'cap', onHand: 5, priority: 1 }];
+  const stock = new Stock(input);
+  stock.level('cap', 'w1').held = 3;
+  assert.equal(input[0].held, undefined);
+  assert.equal(new Stock(input).level('cap', 'w1').held, 0);
+});
+
+test('INV-44: allocate uses available (onHand - held) and never negative', () => {
+  const result = allocate(
+    [
+      { warehouse: 'a', sku: 's', onHand: 5, held: 5, priority: 1 },
+      { warehouse: 'b', sku: 's', onHand: 2, held: 4, priority: 2 },
+      { warehouse: 'c', sku: 's', onHand: 4, held: 1, priority: 3 },
+    ],
+    5,
+  );
+  assert.deepEqual(result, { lines: [{ warehouse: 'c', quantity: 3 }], backorderQuantity: 2 });
+});
+
+test('INV-44: allocate breaks priority ties by warehouse id ascending', () => {
+  const result = allocate(
+    [
+      { warehouse: 'w9', sku: 's', onHand: 3, held: 0, priority: 1 },
+      { warehouse: 'w10', sku: 's', onHand: 3, held: 0, priority: 1 },
+      { warehouse: 'w0', sku: 's', onHand: 3, held: 0, priority: 2 },
+    ],
+    4,
+  );
+  assert.deepEqual(result.lines, [
+    { warehouse: 'w10', quantity: 3 },
+    { warehouse: 'w9', quantity: 1 },
+  ]);
+});
+
+test('INV-44: concurrent reservations cannot oversell', () => {
+  const { book } = setupWithAudit();
+  book.reserve({ orderId: 'o1', sku: 'cap', quantity: 6 });
+  book.reserve({ orderId: 'o2', sku: 'cap', quantity: 4 });
+  assert.throws(() => book.reserve({ orderId: 'o3', sku: 'cap', quantity: 1 }), /insufficient_stock/);
+  assert.equal(book.available('cap'), 0);
+});
+
+test('INV-44: reserve is all-or-nothing (no partial holds)', () => {
+  const { book, stock, audit } = setupWithAudit();
+  assert.throws(() => book.reserve({ orderId: 'o1', sku: 'cap', quantity: 11 }), /insufficient_stock/);
+  assert.equal(stock.level('cap', 'w1').held, 0);
+  assert.equal(stock.level('cap', 'w2').held, 0);
+  assert.equal(book.available('cap'), 10);
+  assert.deepEqual(audit.entries(), []);
+  const ok = book.reserve({ orderId: 'o2', sku: 'cap', quantity: 10 });
+  assert.equal(ok.id, 'res_1');
+  assert.equal(ok.backorderQuantity, 0);
+  assert.throws(() => book.reserve({ orderId: 'o3', sku: 'unknown', quantity: 1 }), /insufficient_stock/);
+});
+
+test('INV-44: hold durations — 10 min standard/missing tier, 30 min vip', () => {
+  const { book } = setupWithAudit();
+  assert.equal(book.reserve({ orderId: 'o1', sku: 'cap', quantity: 1 }).expiresAt, 600_000);
+  assert.equal(book.reserve({ orderId: 'o2', sku: 'cap', quantity: 1, customerTier: 'standard' }).expiresAt, 600_000);
+  assert.equal(book.reserve({ orderId: 'o3', sku: 'cap', quantity: 1, customerTier: 'gold' }).expiresAt, 600_000);
+  assert.equal(book.reserve({ orderId: 'o4', sku: 'cap', quantity: 1, customerTier: 'vip' }).expiresAt, 1_800_000);
+});
+
+test('INV-44: vip hold survives past 10 minutes and expires at 30', () => {
+  const { book, clock } = setupWithAudit();
+  const vip = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 2, customerTier: 'vip' });
+  clock.set(30 * MIN - 1);
+  assert.equal(book.available('cap'), 8);
+  clock.set(30 * MIN);
+  assert.equal(book.available('cap'), 10);
+  assert.throws(() => book.commit(vip.id), /reservation_expired/);
+});
+
+test('INV-44: hold is still active one ms before expiresAt', () => {
+  const { book, clock } = setupWithAudit();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 2 });
+  clock.set(10 * MIN - 1);
+  assert.equal(book.available('cap'), 8);
+  assert.equal(book.commit(hold.id).status, 'committed');
+});
+
+test('INV-44: commit expires due holds first', () => {
+  const { book, clock, audit } = setupWithAudit();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 2 });
+  clock.set(10 * MIN);
+  assert.throws(() => book.commit(hold.id), /reservation_expired/);
+  assert.deepEqual(
+    audit.entries().map((e) => e.type),
+    ['reserved', 'expired'],
+  );
+});
+
+test('INV-44: releasing a committed reservation does not free stock again', () => {
+  const { book, stock } = setupWithAudit();
+  const a = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 3 });
+  book.reserve({ orderId: 'o2', sku: 'cap', quantity: 2 });
+  book.commit(a.id);
+  const again = book.release(a.id);
+  assert.equal(again.status, 'committed');
+  assert.equal(stock.level('cap', 'w1').held, 2);
+  assert.equal(stock.level('cap', 'w1').onHand, 3);
+  assert.equal(book.available('cap'), 5);
+});
+
+test('INV-44: releasing twice records a single audit entry', () => {
+  const { book, stock, audit } = setupWithAudit();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 3 });
+  book.reserve({ orderId: 'o2', sku: 'cap', quantity: 2 });
+  assert.equal(book.release(hold.id).status, 'released');
+  assert.equal(book.release(hold.id).status, 'released');
+  assert.equal(stock.level('cap', 'w1').held, 2);
+  assert.deepEqual(audit.entries().map((e) => e.type), ['reserved', 'reserved', 'released']);
+});
+
+test('INV-44: commit and release error cases', () => {
+  const { book } = setupWithAudit();
+  assert.throws(() => book.release('res_99'), /reservation_not_found/);
+  assert.throws(() => book.commit('res_99'), /reservation_not_found/);
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 1 });
+  book.release(hold.id);
+  assert.throws(() => book.commit(hold.id), /reservation_not_held/);
+  const other = book.reserve({ orderId: 'o2', sku: 'cap', quantity: 1 });
+  book.commit(other.id);
+  assert.throws(() => book.commit(other.id), /reservation_not_held/);
+});
+
+test('INV-44: request validation', () => {
+  const { book } = setupWithAudit();
+  for (const quantity of [0, -1, 1.5, NaN, Infinity, '2', 2 ** 53, undefined])
+    assert.throws(() => book.reserve({ orderId: 'o1', sku: 'cap', quantity }), /invalid_quantity/);
+  for (const [orderId, sku] of [['', 'cap'], ['o1', ''], [1, 'cap'], ['o1', null]])
+    assert.throws(() => book.reserve({ orderId, sku, quantity: 1 }), /invalid_request/);
+  assert.throws(() => book.reserve(undefined), /invalid_request/);
+});
+
+test('INV-44: returned reservations are copies', () => {
+  const { book } = setupWithAudit();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 2 });
+  hold.status = 'committed';
+  hold.lines[0].quantity = 99;
+  const released = book.release(hold.id);
+  assert.equal(released.status, 'released');
+  assert.deepEqual(released.lines, [{ warehouse: 'w1', quantity: 2 }]);
+  assert.equal(book.available('cap'), 10);
+});
+
+test('INV-44: audit entries cannot be changed after the fact', () => {
+  const audit = new AuditLog();
+  const entry = { type: 'reserved', reservationId: 'res_1', at: 5 };
+  audit.record(entry);
+  entry.type = 'released';
+  const entries = audit.entries();
+  entries[0].at = 999;
+  entries.push({ type: 'bogus' });
+  entries.length = 0;
+  assert.deepEqual(audit.entries(), [{ type: 'reserved', reservationId: 'res_1', at: 5 }]);
+});
+
+test('INV-44: book audit trail records each state change', () => {
+  const { book, clock, audit } = setupWithAudit();
+  const a = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 1 });
+  const b = book.reserve({ orderId: 'o2', sku: 'cap', quantity: 1 });
+  clock.set(1000);
+  book.release(a.id);
+  book.commit(b.id);
+  const c = book.reserve({ orderId: 'o3', sku: 'cap', quantity: 1 });
+  clock.set(1000 + 10 * MIN);
+  book.available('cap');
+  assert.deepEqual(audit.entries(), [
+    { type: 'reserved', reservationId: 'res_1', at: 0 },
+    { type: 'reserved', reservationId: 'res_2', at: 0 },
+    { type: 'released', reservationId: 'res_1', at: 1000 },
+    { type: 'committed', reservationId: 'res_2', at: 1000 },
+    { type: 'reserved', reservationId: c.id, at: 1000 },
+    { type: 'expired', reservationId: 'res_3', at: 1000 + 10 * MIN },
+  ]);
+});
+
+test('INV-44: handleReserve maps outcomes to HTTP statuses', () => {
+  const { book } = setupWithAudit();
+  const created = handleReserve(book, { orderId: 'o1', sku: 'cap', quantity: 2 });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.id, 'res_1');
+  assert.equal(created.body.status, 'held');
+  assert.deepEqual(handleReserve(book, { orderId: '', sku: 'cap', quantity: 1 }), { status: 400, body: { error: 'invalid_request' } });
+  assert.deepEqual(handleReserve(book, null), { status: 400, body: { error: 'invalid_request' } });
+  assert.deepEqual(handleReserve(book, { orderId: 'o', sku: 'cap', quantity: 0 }), { status: 400, body: { error: 'invalid_quantity' } });
+  assert.deepEqual(handleReserve(book, { orderId: 'o', sku: 'cap', quantity: 9 }), { status: 409, body: { error: 'insufficient_stock' } });
+  for (const thrown of [new Error('boom'), new Error('constructor'), new Error('toString'), null, 'invalid_request']) {
+    const failing = { reserve: () => { throw thrown; } };
+    assert.deepEqual(handleReserve(failing, {}), { status: 500, body: { error: 'internal' } });
+  }
+});
