+      { id: 'rf_1', merchantId: 'm_1', chargeId: 'x', amountMinor: 100, feeReturnMinor: 5, currency: 'GBP', createdAt: 10 },
+      { id: 'rf_2', merchantId: 'm_1', chargeId: 'u', amountMinor: 200, feeReturnMinor: 8, currency: 'USD', createdAt: 10 },
+    ],
+  });
+  assert.deepEqual(rows.map((row) => row.currency), ['EUR', 'GBP', 'USD']);
+  const [eur, gbp, usd] = rows;
+  assert.deepEqual(eur, { currency: 'EUR', grossMinor: 1000, refundsMinor: 0, feesMinor: 50, netMinor: 950, payoutMinor: 950, carryoverMinor: 0 });
+  assert.deepEqual(gbp, { currency: 'GBP', grossMinor: 0, refundsMinor: 100, feesMinor: -5, netMinor: -95, payoutMinor: 0, carryoverMinor: 95 });
+  const usdFee = feeFor(2000, 'standard') - 8;
+  assert.deepEqual(usd, {
+    currency: 'USD', grossMinor: 2000, refundsMinor: 200, feesMinor: usdFee, netMinor: 1800 - usdFee, payoutMinor: 1800 - usdFee, carryoverMinor: 0,
+  });
+});
+
+test('window is [from, to) for charges and refunds', () => {
+  const rows = settle({
+    merchantId: 'm_1', from: 10, to: 20,
+    charges: [charge({ id: 'a', capturedAt: 10 }), charge({ id: 'b', capturedAt: 20 }), charge({ id: 'c', capturedAt: 9 })],
+    refunds: [
+      { id: 'rf_1', merchantId: 'm_1', chargeId: 'a', amountMinor: 100, feeReturnMinor: 5, currency: 'USD', createdAt: 19 },
+      { id: 'rf_2', merchantId: 'm_1', chargeId: 'a', amountMinor: 100, feeReturnMinor: 5, currency: 'USD', createdAt: 20 },
+      { id: 'rf_3', merchantId: 'm_2', chargeId: 'z', amountMinor: 100, feeReturnMinor: 5, currency: 'USD', createdAt: 15 },
+    ],
+  });
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].grossMinor, 1000);
+  assert.equal(rows[0].refundsMinor, 100);
+  assert.equal(rows[0].feesMinor, 54);
+});
+
+test('negative net floors payout at zero and reports carryover', () => {
+  const [row] = settle({
+    merchantId: 'm_1', from: 100, to: 200,
+    charges: [charge({ id: 'a', capturedAt: 150, amountMinor: 100 })],
+    refunds: [{ id: 'rf_1', merchantId: 'm_1', chargeId: 'old', amountMinor: 1000, feeReturnMinor: 59, currency: 'USD', createdAt: 150 }],
+  });
+  // gross 100, fees 33 - 59 = -26, net = 100 - 1000 + 26 = -874
+  assert.deepEqual(row, { currency: 'USD', grossMinor: 100, refundsMinor: 1000, feesMinor: -26, netMinor: -874, payoutMinor: 0, carryoverMinor: 874 });
+});
+
+test('zero net has zero payout and zero carryover', () => {
+  const [row] = settle({
+    merchantId: 'm_1', from: 0, to: 100,
+    charges: [charge({ id: 'a', amountMinor: 1000 })],
+    refunds: [{ id: 'rf_1', merchantId: 'm_1', chargeId: 'a', amountMinor: 1000, feeReturnMinor: 59, currency: 'USD', createdAt: 50 }],
+  });
+  assert.equal(row.netMinor, 0);
+  assert.equal(row.payoutMinor, 0);
+  assert.equal(row.carryoverMinor, 0);
+});
