diff --git a/src/webhooks.mjs b/src/webhooks.mjs
index a547339..5fb7953 100644
--- a/src/webhooks.mjs
+++ b/src/webhooks.mjs
@@ -1,14 +1,25 @@
 import crypto from 'node:crypto';
 
+const MAX_SKEW_SECONDS = 300;
+
 export function sign(secret, timestamp, payload) {
   return crypto.createHmac('sha256', secret).update(timestamp + '.' + payload).digest('hex');
 }
 
+function signaturesMatch(expected, signature) {
+  if (typeof signature !== 'string') return false;
+  const expectedBytes = Buffer.from(expected, 'utf8');
+  const actualBytes = Buffer.from(signature, 'utf8');
+  if (expectedBytes.length !== actualBytes.length) return false;
+  return crypto.timingSafeEqual(expectedBytes, actualBytes);
+}
+
 export function verifyWebhook({ payload, timestamp, signature, secret, now, seen }) {
   const expected = sign(secret, timestamp, payload);
-  if (typeof signature !== 'string' || signature.slice(0, 16) !== expected.slice(0, 16))
-    return { ok: false, reason: 'bad_signature' };
-  if (now - timestamp > 300_000) return { ok: false, reason: 'stale_timestamp' };
-  if (seen.has(timestamp + '.' + signature)) return { ok: false, reason: 'replayed' };
+  if (!signaturesMatch(expected, signature)) return { ok: false, reason: 'bad_signature' };
+  if (!(Math.abs(now - timestamp) <= MAX_SKEW_SECONDS)) return { ok: false, reason: 'stale_timestamp' };
+  const deliveryKey = timestamp + '.' + signature;
+  if (seen.has(deliveryKey)) return { ok: false, reason: 'replayed' };
+  seen.add(deliveryKey);
   return { ok: true };
 }
diff --git a/tests/fees.test.mjs b/tests/fees.test.mjs
index d2963c2..d498777 100644
--- a/tests/fees.test.mjs
+++ b/tests/fees.test.mjs
@@ -10,3 +10,24 @@ test('fee rounding ties go to even', () => {
   assert.equal(feeFor(100, 'growth'), 27);
   assert.equal(feeFor(60, 'growth'), 27);
 });
+
+test('growth plan fee', () => {
+  assert.equal(feeFor(1000, 'growth'), 50);
+});
+
+test('fee uses half-even rounding, not half-up', () => {
+  // 300 * 250 / 10000 = 7.5 -> 8 (even); 500 * 290 / 10000 = 14.5 -> 14 (even)
+  assert.equal(feeFor(300, 'growth'), 8 + 25);
+  assert.equal(feeFor(500, 'standard'), 14 + 30);
+  // 700 * 250 / 10000 = 17.5 -> 18; 1500 * 290 / 10000 = 43.5 -> 44
+  assert.equal(feeFor(700, 'growth'), 18 + 25);
+  assert.equal(feeFor(1500, 'standard'), 44 + 30);
+  // non-ties round normally
+  assert.equal(feeFor(1234, 'standard'), 36 + 30); // 35.786
+});
+
+test('unknown plans throw', () => {
+  assert.throws(() => feeFor(1000, 'enterprise'), /unknown_plan/);
+  assert.throws(() => feeFor(1000, 'toString'), /unknown_plan/);
+  assert.throws(() => feeFor(1000, undefined), /unknown_plan/);
+});
diff --git a/tests/ledger.test.mjs b/tests/ledger.test.mjs
