+++ b/tests/ledger.test.mjs
@@ -0,0 +1,26 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Ledger } from '../src/ledger.mjs';
+
+test('refund lines are balanced and the merchant is debited net of the fee return', () => {
+  const ledger = new Ledger();
+  ledger.postRefund({ id: 'rf_1', merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, feeReturnMinor: 23, currency: 'USD', createdAt: 1 });
+  assert.deepEqual(ledger.lines, [
+    { account: 'customer_refunds', amountMinor: 400, currency: 'USD', refundId: 'rf_1' },
+    { account: 'merchant:m_1', amountMinor: -377, currency: 'USD', refundId: 'rf_1' },
+    { account: 'fees', amountMinor: -23, currency: 'USD', refundId: 'rf_1' },
+  ]);
+  assert.equal(ledger.lines.reduce((total, line) => total + line.amountMinor, 0), 0);
+});
+
+test('balance sums an account per currency', () => {
+  const ledger = new Ledger();
+  ledger.postRefund({ id: 'rf_1', merchantId: 'm_1', amountMinor: 400, feeReturnMinor: 23, currency: 'USD' });
+  ledger.postRefund({ id: 'rf_2', merchantId: 'm_1', amountMinor: 600, feeReturnMinor: 36, currency: 'USD' });
+  ledger.postRefund({ id: 'rf_3', merchantId: 'm_1', amountMinor: 100, feeReturnMinor: 5, currency: 'EUR' });
+  assert.equal(ledger.balance('merchant:m_1', 'USD'), -941);
+  assert.equal(ledger.balance('fees', 'USD'), -59);
+  assert.equal(ledger.balance('customer_refunds', 'USD'), 1000);
+  assert.equal(ledger.balance('merchant:m_1', 'EUR'), -95);
+  assert.equal(ledger.balance('merchant:m_2', 'USD'), 0);
+});
