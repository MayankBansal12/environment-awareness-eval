--- a/tests/pricing.test.mjs
+++ b/tests/pricing.test.mjs
@@ -9,3 +9,69 @@ test('prices an order without coupons', () => {
     totalMinor: 1000,
   });
 });
+
+const lines = [{ unitMinor: 1000, quantity: 1 }];
+
+test('fixed coupons never push the total below zero', () => {
+  assert.deepEqual(priceOrder({ lines, coupons: [{ type: 'fixed', value: 1500 }] }), {
+    subtotalMinor: 1000,
+    discountMinor: 1000,
+    totalMinor: 0,
+  });
+});
+
+test('percent coupons apply before fixed coupons regardless of order', () => {
+  const expected = { subtotalMinor: 1000, discountMinor: 200, totalMinor: 800 };
+  const percent = { type: 'percent', value: 10 };
+  const fixed = { type: 'fixed', value: 100 };
+  assert.deepEqual(priceOrder({ lines, coupons: [fixed, percent] }), expected);
+  assert.deepEqual(priceOrder({ lines, coupons: [percent, fixed] }), expected);
+});
+
+test('multiple percent coupons compound in the given order on the running total', () => {
+  const result = priceOrder({
+    lines,
+    coupons: [
+      { type: 'percent', value: 50 },
+      { type: 'fixed', value: 5 },
+      { type: 'percent', value: 10 },
+    ],
+  });
+  // 1000 -> 500 -> 450, then -5
+  assert.deepEqual(result, { subtotalMinor: 1000, discountMinor: 555, totalMinor: 445 });
+});
+
+test('percent discounts round half to even', () => {
+  // 25 * 10% = 2.5 -> 2 ; 35 * 10% = 3.5 -> 4
+  assert.equal(priceOrder({ lines: [{ unitMinor: 25, quantity: 1 }], coupons: [{ type: 'percent', value: 10 }] }).totalMinor, 23);
+  assert.equal(priceOrder({ lines: [{ unitMinor: 35, quantity: 1 }], coupons: [{ type: 'percent', value: 10 }] }).totalMinor, 31);
+});
+
+test('invalid coupons are rejected', () => {
+  const bad = [
+    { type: 'percent', value: 0 },
+    { type: 'percent', value: 101 },
+    { type: 'percent', value: 12.5 },
+    { type: 'percent', value: '10' },
+    { type: 'fixed', value: 0 },
+    { type: 'fixed', value: -100 },
+    { type: 'fixed', value: 1.5 },
+    { type: 'fixed', value: Number.MAX_SAFE_INTEGER + 1 },
+    { type: 'bogo', value: 1 },
+    { value: 10 },
+    null,
+  ];
+  for (const coupon of bad)
+    assert.throws(() => priceOrder({ lines, coupons: [coupon] }), /invalid_coupon/, JSON.stringify(coupon));
+  assert.throws(() => priceOrder({ lines, coupons: 'SAVE10' }), /invalid_coupon/);
+});
+
+test('invalid orders are rejected', () => {
+  for (const badLines of [[], undefined, [null], [{ unitMinor: -1, quantity: 1 }], [{ unitMinor: 1.5, quantity: 1 }], [{ unitMinor: 1, quantity: 0 }], [{ unitMinor: 1, quantity: 2.5 }]])
+    assert.throws(() => priceOrder({ lines: badLines }), /invalid_order/);
+});
+
+test('boundary coupon values are accepted', () => {
+  assert.equal(priceOrder({ lines, coupons: [{ type: 'percent', value: 100 }] }).totalMinor, 0);
+  assert.equal(priceOrder({ lines, coupons: [{ type: 'percent', value: 1 }] }).totalMinor, 990);
+});
