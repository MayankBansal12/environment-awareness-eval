+  const a = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 1 });
+  const b = book.reserve({ orderId: 'o2', sku: 'cap', quantity: 1 });
+  const c = book.reserve({ orderId: 'o3', sku: 'cap', quantity: 1 });
+  now = 1;
+  book.release(a.id);
+  book.release(a.id);
+  book.commit(b.id);
+  now = 10 * MIN;
+  book.available('cap');
+  const expected = [
+    { type: 'reserved', reservationId: 'res_1', at: 0 },
+    { type: 'reserved', reservationId: 'res_2', at: 0 },
+    { type: 'reserved', reservationId: 'res_3', at: 0 },
+    { type: 'released', reservationId: 'res_1', at: 1 },
+    { type: 'committed', reservationId: 'res_2', at: 1 },
+    { type: 'expired', reservationId: c.id, at: 10 * MIN },
+  ];
+  const entries = audit.entries();
+  assert.deepEqual(entries, expected);
+  entries[0].type = 'tampered';
+  entries.push({ type: 'fake' });
+  entries.length = 0;
+  assert.deepEqual(audit.entries(), expected);
+});
+
+test('AuditLog stores a copy of the recorded entry', () => {
+  const audit = new AuditLog();
+  const entry = { type: 'reserved', reservationId: 'res_1', at: 5 };
+  audit.record(entry);
+  entry.at = 99;
+  audit.entries()[0].reservationId = 'res_x';
+  assert.deepEqual(audit.entries(), [{ type: 'reserved', reservationId: 'res_1', at: 5 }]);
+});
