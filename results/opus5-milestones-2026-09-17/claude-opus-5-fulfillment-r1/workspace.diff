diff --git a/tests/api.test.mjs b/tests/api.test.mjs
new file mode 100644
index 0000000..da8766d
--- /dev/null
+++ b/tests/api.test.mjs
@@ -0,0 +1,48 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Stock } from '../src/stock.mjs';
+import { ReservationBook } from '../src/reservations.mjs';
+import { handleReserve } from '../src/api.mjs';
+
+const makeBook = () =>
+  new ReservationBook(new Stock([{ warehouse: 'w1', sku: 'cap', onHand: 5, priority: 1 }]), () => 0);
+
+test('successful reserve returns 201 with the reservation', () => {
+  const res = handleReserve(makeBook(), { orderId: 'o1', sku: 'cap', quantity: 2, customerTier: 'vip' });
+  assert.deepEqual(res, {
+    status: 201,
+    body: {
+      id: 'res_1',
+      orderId: 'o1',
+      sku: 'cap',
+      lines: [{ warehouse: 'w1', quantity: 2 }],
+      backorderQuantity: 0,
+      status: 'held',
+      expiresAt: 30 * 60_000,
+    },
+  });
+});
+
+test('validation errors map to 400', () => {
+  const book = makeBook();
+  assert.deepEqual(handleReserve(book, undefined), { status: 400, body: { error: 'invalid_request' } });
+  assert.deepEqual(handleReserve(book, { orderId: 'o1', sku: 'cap', quantity: 0 }), {
+    status: 400,
+    body: { error: 'invalid_quantity' },
+  });
+});
+
+test('insufficient stock maps to 409 and holds nothing', () => {
+  const book = makeBook();
+  assert.deepEqual(handleReserve(book, { orderId: 'o1', sku: 'cap', quantity: 6 }), {
+    status: 409,
+    body: { error: 'insufficient_stock' },
+  });
+  assert.equal(book.available('cap'), 5);
+});
+
+test('other errors map to 500 internal without leaking details', () => {
+  const throwing = (error) => ({ reserve: () => { throw error; } });
+  for (const error of [new Error('boom'), new Error('toString'), new Error('__proto__'), 'invalid_request', null])
+    assert.deepEqual(handleReserve(throwing(error), {}), { status: 500, body: { error: 'internal' } });
+});
diff --git a/tests/pricing.test.mjs b/tests/pricing.test.mjs
