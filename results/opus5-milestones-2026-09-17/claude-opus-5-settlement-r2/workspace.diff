+  assert.deepEqual(verifyWebhook(delivery({ signature: tampered })), { ok: false, reason: 'bad_signature' });
+  assert.deepEqual(verifyWebhook(delivery({ signature: good.slice(0, 16) })), { ok: false, reason: 'bad_signature' });
