+});
+
+test('signature must match exactly, including case', () => {
+  const good = sign(secret, 1000, payload);
+  assert.notEqual(good.toUpperCase(), good);
+  assert.deepEqual(verifyWebhook(delivery({ signature: good.toUpperCase() })), { ok: false, reason: 'bad_signature' });
+});
+
+test('rejects missing or non-string signatures and wrong payloads', () => {
