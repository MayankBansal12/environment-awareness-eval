+    refunds: [refund({ createdAt: 150, amountMinor: 1000, feeReturnMinor: 59 })],
+  });
+  // gross 100, fee 33 - 59 returned = -26, net = 100 - 1000 + 26 = -874
+  assert.deepEqual(rows, [
+    { currency: 'USD', grossMinor: 100, refundsMinor: 1000, feesMinor: -26, netMinor: -874, payoutMinor: 0, carryoverMinor: 874 },
+  ]);
+});
+
+test('zero net keeps carryover 0', () => {
+  const [row] = settle({
+    merchantId: 'm_1',
+    from: 0,
+    to: 100,
+    charges: [charge({ id: 'a', amountMinor: 59 + 0, plan: 'standard' })],
+    refunds: [refund({ amountMinor: 59 - 32, feeReturnMinor: 0 })],
+  });
+  // fee on 59 = round(1.711) = 2 + 30 = 32; net = 59 - 27 - 32 = 0
+  assert.equal(row.netMinor, 0);
+  assert.ok(Object.is(row.payoutMinor, 0));
+  assert.ok(Object.is(row.carryoverMinor, 0));
+});
