+  assert.deepEqual(verifyWebhook(delivery({ now: 1301 })), { ok: false, reason: 'stale_timestamp' });
+  assert.deepEqual(verifyWebhook(delivery({ now: 699 })), { ok: false, reason: 'stale_timestamp' });
