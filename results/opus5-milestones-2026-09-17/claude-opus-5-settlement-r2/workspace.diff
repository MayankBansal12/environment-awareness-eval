+  const ledger = new Ledger();
+  const late = new RefundBook(charges(), ledger, () => 10 * DAY + WINDOW + 1);
+  assert.throws(() => late.refund(req), /refund_window_expired/);
+  assert.equal(ledger.lines.length, 0);
+});
+
+test('refund window: replay still returns after expiry, window checked before capture limit', () => {
+  let now = 11 * DAY;
+  const b = new RefundBook(charges(), new Ledger(), () => now);
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k' });
+  now = 10 * DAY + WINDOW + 1;
+  assert.deepEqual(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k' }), first);
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 5000, idempotencyKey: 'k2' }),
+    /refund_window_expired/,
+  );
+});
