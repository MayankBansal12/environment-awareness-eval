+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Ledger } from '../src/ledger.mjs';
+
+test('refund lines are balanced and the merchant keeps the returned fee', () => {
+  const ledger = new Ledger();
+  ledger.postRefund({ id: 'rf_1', merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, feeReturnMinor: 23, currency: 'USD', createdAt: 1 });
+  assert.deepEqual(ledger.lines, [
+    { account: 'customer_refunds', amountMinor: 400, currency: 'USD', refundId: 'rf_1' },
+    { account: 'merchant:m_1', amountMinor: -377, currency: 'USD', refundId: 'rf_1' },
+    { account: 'fees', amountMinor: -23, currency: 'USD', refundId: 'rf_1' },
+  ]);
+  assert.equal(ledger.balance('merchant:m_1', 'USD'), -377);
+  assert.equal(ledger.balance('customer_refunds', 'USD') + ledger.balance('merchant:m_1', 'USD') + ledger.balance('fees', 'USD'), 0);
+  assert.equal(ledger.balance('merchant:m_1', 'EUR'), 0);
+});
diff --git a/tests/refunds.test.mjs b/tests/refunds.test.mjs
