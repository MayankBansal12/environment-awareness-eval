--- a/tests/refunds.test.mjs
+++ b/tests/refunds.test.mjs
@@ -33,3 +33,141 @@ test('idempotency keys are merchant scoped', () => {
   assert.equal(other.chargeId, 'ch_2');
   assert.deepEqual(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 999, idempotencyKey: 'same' }), first);
 });
+
+const WINDOW = 30 * DAY;
+
+test('total refunded across many partial refunds cannot exceed capture', () => {
+  const b = book();
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k1' });
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k2' });
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 300, idempotencyKey: 'k3' }),
+    /refund_exceeds_capture/,
+  );
+  const last = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 200, idempotencyKey: 'k4' });
+  assert.equal(last.amountMinor, 200);
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 1, idempotencyKey: 'k5' }),
+    /refund_exceeds_capture/,
+  );
+});
+
+test('a rejected refund posts nothing', () => {
+  const ledger = new Ledger();
+  const b = new RefundBook(charges(), ledger, () => 11 * DAY);
+  assert.throws(() => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 1001, idempotencyKey: 'k1' }), /refund_exceeds_capture/);
+  assert.equal(ledger.lines.length, 0);
+  // the key was not consumed by the failed attempt
+  assert.equal(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 10, idempotencyKey: 'k1' }).amountMinor, 10);
+});
+
+test('fully refunding a charge returns the whole fee', () => {
+  const ledger = new Ledger();
+  const b = new RefundBook(charges(), ledger, () => 11 * DAY);
+  // fee for ch_1 is 59; floor(59 * 333 / 1000) = 19 each time
+  const parts = [333, 333, 334].map((amountMinor, i) =>
+    b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor, idempotencyKey: 'k' + i }),
+  );
+  assert.deepEqual(parts.map((r) => r.feeReturnMinor), [19, 19, 21]);
+  assert.equal(ledger.balance('fees', 'USD'), -59);
+  assert.equal(ledger.balance('merchant:m_1', 'USD'), -(1000 - 59));
+  assert.equal(ledger.balance('customer_refunds', 'USD'), 1000);
+});
+
+test('a single full refund returns the whole fee', () => {
+  const refund = book().refund({ merchantId: 'm_2', chargeId: 'ch_2', amountMinor: 500, idempotencyKey: 'k' });
+  assert.equal(refund.feeReturnMinor, 37); // growth fee on 500: 12.5 -> 12 (half-even) + 25
+});
+
+test('refund shape, ids, clock and ledger posting', () => {
+  const ledger = new Ledger();
+  let t = 11 * DAY;
+  const b = new RefundBook(charges(), ledger, () => t++);
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'a' });
+  const second = b.refund({ merchantId: 'm_2', chargeId: 'ch_2', amountMinor: 100, idempotencyKey: 'a' });
+  assert.deepEqual(first, { id: 'rf_1', merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, feeReturnMinor: 23, currency: 'USD', createdAt: 11 * DAY });
+  assert.equal(second.id, 'rf_2');
+  assert.equal(second.createdAt, 11 * DAY + 1);
+  assert.equal(ledger.lines.length, 6);
+  assert.equal(ledger.balance('merchant:m_1', 'USD'), -377);
+});
+
+test('idempotent replay returns the original without posting', () => {
+  const ledger = new Ledger();
+  const b = new RefundBook(charges(), ledger, () => 11 * DAY);
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k' });
+  const replay = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 700, idempotencyKey: 'k' });
+  assert.deepEqual(replay, first);
+  assert.equal(ledger.lines.length, 3);
+  assert.equal(ledger.balance('customer_refunds', 'USD'), 400);
+});
+
+test('same key from a different merchant is independent', () => {
+  const ledger = new Ledger();
+  const b = new RefundBook(charges(), ledger, () => 11 * DAY);
+  const a = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'same' });
+  const c = b.refund({ merchantId: 'm_2', chargeId: 'ch_2', amountMinor: 50, idempotencyKey: 'same' });
+  assert.notEqual(a.id, c.id);
+  assert.equal(c.merchantId, 'm_2');
+  assert.equal(c.amountMinor, 50);
+  assert.equal(ledger.balance('customer_refunds', 'USD'), 150);
+});
+
+test('returned refunds are copies', () => {
+  const b = book();
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k' });
+  first.amountMinor = 1;
+  first.feeReturnMinor = 0;
+  const replay = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k' });
+  assert.equal(replay.amountMinor, 400);
+  assert.equal(replay.feeReturnMinor, 23);
+  replay.amountMinor = 1;
+  // mutation must not let the capture limit be bypassed
+  assert.throws(() => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 601, idempotencyKey: 'k2' }), /refund_exceeds_capture/);
