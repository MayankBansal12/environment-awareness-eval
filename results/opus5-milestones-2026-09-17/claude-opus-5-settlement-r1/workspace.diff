+  assert.equal(last.amountMinor, 50);
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 1, idempotencyKey: 'k7' }),
+    /refund_exceeds_capture/,
+  );
+});
+
+test('fully refunding a charge returns the whole fee', () => {
+  const ledger = new Ledger();
+  const b = new RefundBook(allCharges(), ledger, () => 11 * DAY);
+  // ch_3 fee: roundHalfEven(999*250/10000 = 24.975) + 25 = 50
+  const parts = [333, 333, 333].map((amountMinor, i) =>
+    b.refund({ merchantId: 'm_1', chargeId: 'ch_3', amountMinor, idempotencyKey: 'p' + i }),
+  );
+  assert.deepEqual(parts.map((r) => r.feeReturnMinor), [16, 16, 18]);
+  assert.equal(ledger.balance('fees', 'EUR'), -50);
+
+  const whole = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 1000, idempotencyKey: 'w' });
+  assert.equal(whole.feeReturnMinor, 59);
+});
+
+test('refund shape, ids, clock and copies', () => {
+  let now = 11 * DAY;
+  const b = new RefundBook(allCharges(), new Ledger(), () => now);
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k1' });
+  now += 5;
+  const second = b.refund({ merchantId: 'm_2', chargeId: 'ch_2', amountMinor: 100, idempotencyKey: 'k1' });
+  assert.deepEqual(first, {
+    id: 'rf_1', merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, feeReturnMinor: 23, currency: 'USD', createdAt: 11 * DAY,
+  });
+  assert.equal(second.id, 'rf_2');
+  assert.equal(second.createdAt, 11 * DAY + 5);
+  first.amountMinor = 1;
+  first.feeReturnMinor = 0;
+  assert.equal(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 400, idempotencyKey: 'k1' }).amountMinor, 400);
+  assert.equal(b.refunds[0].amountMinor, 400);
+});
+
+test('idempotent replay posts nothing and returns the original even for a different amount', () => {
+  const ledger = new Ledger();
+  const b = new RefundBook(allCharges(), ledger, () => 11 * DAY);
+  const first = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k' });
+  const lines = ledger.lines.length;
+  assert.deepEqual(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 5000, idempotencyKey: 'k' }), first);
+  assert.equal(ledger.lines.length, lines);
+  assert.equal(b.refunds.length, 1);
+});
+
+test('same key for another merchant is independent', () => {
+  const b = book();
+  const a = b.refund({ merchantId: 'm_2', chargeId: 'ch_2', amountMinor: 50, idempotencyKey: 'same' });
+  const c = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'same' });
+  assert.equal(a.merchantId, 'm_2');
+  assert.equal(c.merchantId, 'm_1');
+  assert.equal(c.chargeId, 'ch_1');
+  assert.equal(c.amountMinor, 100);
+  assert.notEqual(a.id, c.id);
+});
+
+test('validation, ownership and capture status', () => {
+  const b = new RefundBook(allCharges(), new Ledger(), () => 11 * DAY);
+  const ok = { merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k' };
+  for (const bad of [
+    { ...ok, merchantId: '' },
+    { ...ok, chargeId: 7 },
+    { ...ok, idempotencyKey: '' },
+    { ...ok, amountMinor: 0 },
+    { ...ok, amountMinor: -5 },
+    { ...ok, amountMinor: 1.5 },
+    { ...ok, amountMinor: 2 ** 53 },
+    { ...ok, amountMinor: '100' },
+  ])
+    assert.throws(() => b.refund(bad), /invalid_refund/);
+  assert.throws(() => b.refund(), /invalid_refund/);
+  assert.throws(() => b.refund({ ...ok, chargeId: 'ch_nope' }), /charge_not_found/);
+  assert.throws(() => b.refund({ ...ok, merchantId: 'm_2' }), /charge_not_found/);
+  assert.throws(() => b.refund({ ...ok, chargeId: 'ch_p' }), /charge_not_captured/);
+});
+
+test('refund window: exactly 30 days allowed, later rejected', () => {
+  let now = 40 * DAY; // ch_1 captured at day 10
+  const ledger = new Ledger();
+  const b = new RefundBook(allCharges(), ledger, () => now);
+  const atLimit = b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' });
+  assert.equal(atLimit.createdAt, 40 * DAY);
+  now = 40 * DAY + 1;
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k2' }),
+    /refund_window_expired/,
+  );
+  assert.equal(ledger.lines.length, 3);
+  // Idempotent replay of an existing refund still works after the window.
+  assert.deepEqual(b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 100, idempotencyKey: 'k1' }), atLimit);
+  // Window is checked before the capture limit.
+  assert.throws(
+    () => b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 5000, idempotencyKey: 'k3' }),
+    /refund_window_expired/,
+  );
+});
