 });
+
+const allCharges = () => [
+  ...charges(),
+  { id: 'ch_3', merchantId: 'm_1', amountMinor: 999, currency: 'EUR', plan: 'growth', status: 'captured', capturedAt: 10 * DAY },
+  { id: 'ch_p', merchantId: 'm_1', amountMinor: 1000, currency: 'USD', plan: 'standard', status: 'pending', capturedAt: null },
+];
+
+test('cumulative refunds cannot exceed the captured amount', () => {
+  const b = book();
+  b.refund({ merchantId: 'm_1', chargeId: 'ch_1', amountMinor: 600, idempotencyKey: 'k1' });
+  // Only 400 remains; the old check compared against the last refund (600) alone.
+  assert.throws(
