diff --git a/tests/inventory.test.mjs b/tests/inventory.test.mjs
new file mode 100644
index 0000000..450e856
--- /dev/null
+++ b/tests/inventory.test.mjs
@@ -0,0 +1,118 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Stock } from '../src/stock.mjs';
+import { allocate } from '../src/allocation.mjs';
+import { AuditLog } from '../src/audit.mjs';
+import { ReservationBook } from '../src/reservations.mjs';
+import { handleReserve } from '../src/api.mjs';
+
+test('Stock copies levels and level() returns the live level', () => {
+  const input = [{ warehouse: 'w1', sku: 'cap', onHand: 5, held: 1, priority: 1 }];
+  const stock = new Stock(input);
+  input[0].onHand = 99;
+  assert.equal(stock.level('cap', 'w1').onHand, 5);
+  stock.level('cap', 'w1').held = 3;
+  assert.equal(stock.level('cap', 'w1').held, 3);
+  assert.equal(input[0].held, 1);
+  assert.equal(new Stock([{ warehouse: 'w1', sku: 'cap', onHand: 5, priority: 1 }]).level('cap', 'w1').held, 0);
+});
+
+test('allocate takes only available quantity (onHand - held)', () => {
+  const levels = [
+    { warehouse: 'w1', sku: 'cap', onHand: 5, held: 4, priority: 1 },
+    { warehouse: 'w2', sku: 'cap', onHand: 5, held: 0, priority: 2 },
+  ];
+  assert.deepEqual(allocate(levels, 3), {
+    lines: [
+      { warehouse: 'w1', quantity: 1 },
+      { warehouse: 'w2', quantity: 2 },
+    ],
+    backorderQuantity: 0,
+  });
+});
+
+test('allocate skips levels with nothing available, including over-held levels', () => {
+  const levels = [
+    { warehouse: 'w1', sku: 'cap', onHand: 2, held: 5, priority: 1 },
+    { warehouse: 'w2', sku: 'cap', onHand: 3, held: 3, priority: 2 },
+    { warehouse: 'w3', sku: 'cap', onHand: 2, held: 0, priority: 3 },
+  ];
+  assert.deepEqual(allocate(levels, 4), {
+    lines: [{ warehouse: 'w3', quantity: 2 }],
+    backorderQuantity: 2,
+  });
+});
+
+test('allocate breaks priority ties by warehouse id ascending and does not mutate input', () => {
+  const levels = [
+    { warehouse: 'w9', sku: 'cap', onHand: 2, held: 0, priority: 1 },
+    { warehouse: 'w10', sku: 'cap', onHand: 2, held: 0, priority: 2 },
+    { warehouse: 'w3', sku: 'cap', onHand: 2, held: 0, priority: 1 },
+  ];
+  const snapshot = structuredClone(levels);
+  assert.deepEqual(allocate(levels, 5).lines, [
+    { warehouse: 'w3', quantity: 2 },
+    { warehouse: 'w9', quantity: 2 },
+    { warehouse: 'w10', quantity: 1 },
+  ]);
+  assert.deepEqual(levels, snapshot);
+});
+
+test('audit log stores copies and returns copies', () => {
+  const log = new AuditLog();
+  const entry = { type: 'reserved', reservationId: 'res_1', at: 1 };
+  log.record(entry);
+  entry.type = 'committed';
+
+  const first = log.entries();
+  first[0].at = 999;
+  first.push({ type: 'expired', reservationId: 'res_2', at: 2 });
+  first.length = 0;
+
+  assert.deepEqual(log.entries(), [{ type: 'reserved', reservationId: 'res_1', at: 1 }]);
+});
+
+const book = () =>
+  new ReservationBook(new Stock([{ warehouse: 'w1', sku: 'cap', onHand: 3, priority: 1 }]), () => 0);
+
+test('handleReserve returns 201 with the reservation', () => {
+  const response = handleReserve(book(), { orderId: 'o1', sku: 'cap', quantity: 2 });
+  assert.equal(response.status, 201);
+  assert.equal(response.body.id, 'res_1');
+  assert.equal(response.body.status, 'held');
+});
+
+test('handleReserve maps client errors', () => {
+  assert.deepEqual(handleReserve(book(), { orderId: '', sku: 'cap', quantity: 1 }), {
+    status: 400,
+    body: { error: 'invalid_request' },
+  });
+  assert.deepEqual(handleReserve(book(), null), { status: 400, body: { error: 'invalid_request' } });
+  assert.deepEqual(handleReserve(book(), { orderId: 'o1', sku: 'cap', quantity: 1.5 }), {
+    status: 400,
+    body: { error: 'invalid_quantity' },
+  });
+  assert.deepEqual(handleReserve(book(), { orderId: 'o1', sku: 'cap', quantity: 4 }), {
+    status: 409,
+    body: { error: 'insufficient_stock' },
+  });
+});
+
+test('handleReserve maps everything else to 500 internal', () => {
+  for (const thrown of [
+    new Error('boom'),
+    new Error('constructor'),
+    new Error('toString'),
+    new Error('__proto__'),
+    'invalid_request',
+    { message: 'insufficient_stock' },
+    undefined,
+  ]) {
+    const failing = {
+      reserve() {
+        throw thrown;
+      },
+    };
+    assert.deepEqual(handleReserve(failing, {}), { status: 500, body: { error: 'internal' } }, String(thrown));
+  }
+});
