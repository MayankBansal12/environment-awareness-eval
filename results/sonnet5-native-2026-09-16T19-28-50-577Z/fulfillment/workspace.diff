diff --git a/tests/pricing.test.mjs b/tests/pricing.test.mjs
index 0f6be2e..7894c80 100644
--- a/tests/pricing.test.mjs
+++ b/tests/pricing.test.mjs
@@ -9,3 +9,53 @@ test('prices an order without coupons', () => {
     totalMinor: 1000,
   });
 });
+
+test('percent coupons apply before fixed coupons regardless of input order', () => {
+  const lines = [{ unitMinor: 1000, quantity: 1 }];
+  const percentFirst = priceOrder({
+    lines,
+    coupons: [
+      { type: 'percent', value: 50 },
+      { type: 'fixed', value: 300 },
+    ],
+  });
+  const fixedFirst = priceOrder({
+    lines,
+    coupons: [
+      { type: 'fixed', value: 300 },
+      { type: 'percent', value: 50 },
+    ],
+  });
+  assert.deepEqual(percentFirst, { subtotalMinor: 1000, discountMinor: 800, totalMinor: 200 });
+  assert.deepEqual(fixedFirst, percentFirst);
+});
+
+test('total never goes below 0 even with stacked fixed coupons', () => {
+  const result = priceOrder({
+    lines: [{ unitMinor: 500, quantity: 1 }],
+    coupons: [
+      { type: 'fixed', value: 300 },
+      { type: 'fixed', value: 400 },
+    ],
+  });
+  assert.deepEqual(result, { subtotalMinor: 500, discountMinor: 500, totalMinor: 0 });
+});
+
+test('percent coupon discount uses round-half-even', () => {
+  const result = priceOrder({
+    lines: [{ unitMinor: 25, quantity: 1 }],
+    coupons: [{ type: 'percent', value: 50 }],
+  });
+  // 25 * 50 / 100 = 12.5 -> round half to even -> 12
+  assert.deepEqual(result, { subtotalMinor: 25, discountMinor: 12, totalMinor: 13 });
+});
+
+test('rejects invalid coupons', () => {
+  const lines = [{ unitMinor: 1000, quantity: 1 }];
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'percent', value: 0 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'percent', value: 101 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'percent', value: 1.5 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'fixed', value: 0 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'fixed', value: -5 }] }), /invalid_coupon/);
+  assert.throws(() => priceOrder({ lines, coupons: [{ type: 'other', value: 5 }] }), /invalid_coupon/);
+});
diff --git a/tests/reservations.test.mjs b/tests/reservations.test.mjs
index d63ace7..5866f42 100644
--- a/tests/reservations.test.mjs
+++ b/tests/reservations.test.mjs
@@ -2,6 +2,8 @@ import { test } from 'node:test';
 import assert from 'node:assert/strict';
 import { Stock } from '../src/stock.mjs';
 import { ReservationBook } from '../src/reservations.mjs';
+import { AuditLog } from '../src/audit.mjs';
+import { allocate } from '../src/allocation.mjs';
 
 const MIN = 60_000;
 const setup = () => {
@@ -44,3 +46,85 @@ test('quantities must be positive integers', () => {
   for (const quantity of [0, -1, 1.5])
     assert.throws(() => book.reserve({ orderId: 'o1', sku: 'cap', quantity }), /invalid_quantity/);
 });
+
+test('reserve is all-or-nothing: insufficient stock holds nothing', () => {
+  const { book, stock } = setup();
+  assert.throws(
+    () => book.reserve({ orderId: 'o1', sku: 'cap', quantity: 11 }),
+    /insufficient_stock/,
+  );
+  assert.equal(book.available('cap'), 10);
+  assert.equal(stock.level('cap', 'w1').held, 0);
+  assert.equal(stock.level('cap', 'w2').held, 0);
+});
+
+test('successful reservations always have backorderQuantity 0', () => {
+  const { book } = setup();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 10 });
+  assert.equal(hold.backorderQuantity, 0);
+});
+
+test('vip holds last 30 minutes, other and missing tiers last 10', () => {
+  const { clock, book } = setup();
+  const vip = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 1, customerTier: 'vip' });
+  const standard = book.reserve({ orderId: 'o2', sku: 'cap', quantity: 1, customerTier: 'standard' });
+  const untiered = book.reserve({ orderId: 'o3', sku: 'cap', quantity: 1 });
+  assert.equal(vip.expiresAt, 30 * MIN);
+  assert.equal(standard.expiresAt, 10 * MIN);
+  assert.equal(untiered.expiresAt, 10 * MIN);
+
+  clock.set(15 * MIN);
+  assert.equal(book.available('cap'), 9); // standard and untiered expired, vip still held
+  const refreshedVip = book.release(vip.id);
+  assert.equal(refreshedVip.status, 'released');
+});
+
+test('commit expires a due hold instead of committing it', () => {
+  const { clock, book } = setup();
+  const hold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 2 });
+  clock.set(10 * MIN);
+  assert.throws(() => book.commit(hold.id), /reservation_expired/);
+  assert.equal(book.available('cap'), 10);
+});
+
+test('release of a committed or expired reservation changes nothing', () => {
+  const { clock, book } = setup();
+  const committedHold = book.reserve({ orderId: 'o1', sku: 'cap', quantity: 2 });
+  book.commit(committedHold.id);
+  const beforeCommittedRelease = book.available('cap');
+  const afterCommittedRelease = book.release(committedHold.id);
+  assert.equal(afterCommittedRelease.status, 'committed');
+  assert.equal(book.available('cap'), beforeCommittedRelease);
+
+  const expiringHold = book.reserve({ orderId: 'o2', sku: 'cap', quantity: 3 });
+  clock.set(10 * MIN);
+  const afterExpiredRelease = book.release(expiringHold.id);
+  assert.equal(afterExpiredRelease.status, 'expired');
+  assert.equal(book.available('cap'), 10 - 2); // only the committed 2 remain unavailable
+});
+
+test('allocation ties are broken by ascending warehouse id', () => {
+  const { lines } = allocate(
+    [
+      { warehouse: 'w2', onHand: 5, held: 0, priority: 1 },
+      { warehouse: 'w1', onHand: 5, held: 0, priority: 1 },
+    ],
+    3,
+  );
+  assert.deepEqual(lines, [{ warehouse: 'w1', quantity: 3 }]);
+});
+
+test('audit log stores and returns independent copies', () => {
+  const audit = new AuditLog();
+  const entry = { type: 'reserved', reservationId: 'res_1', at: 1 };
+  audit.record(entry);
+  entry.type = 'tampered';
+  const [stored] = audit.entries();
+  assert.equal(stored.type, 'reserved');
+
+  stored.type = 'also-tampered';
+  assert.equal(audit.entries()[0].type, 'reserved');
+
+  audit.entries().push({ type: 'injected', reservationId: 'res_2', at: 2 });
+  assert.equal(audit.entries().length, 1);
+});
