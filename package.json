{
  "name": "environment-awareness-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Behavioral environment-change blindness eval harness for coding agents (Pi track, v0)",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "eval": "tsx src/cli.ts",
    "eval:v2": "tsx src/v2/cli.ts",
    "eval:v3": "tsx src/v3/cli.ts",
    "eval:experiment": "tsx src/v2/experiment-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "viz": "pnpm --filter @eaw/viewer build && node -e \"console.log('\\nviewer built: ' + require('path').resolve('viewer/dist/index.html'))\"",
    "viz:test": "pnpm --filter @eaw/viewer test",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "typebox": "1.3.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "prettier": "^3.4.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
