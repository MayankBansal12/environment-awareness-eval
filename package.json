{
  "name": "environment-awareness-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Measures whether coding agents notice and act on workplace updates while debugging, as cognitive load rises",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "eval": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "viz": "pnpm --filter @eaw/viewer build",
    "viz:serve": "pnpm --filter @eaw/viewer preview",
    "viz:test": "pnpm --filter @eaw/viewer typecheck && pnpm --filter @eaw/viewer test",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"viewer/{src,scripts,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"viewer/{src,scripts,tests}/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "typebox": "1.3.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "prettier": "^3.4.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
